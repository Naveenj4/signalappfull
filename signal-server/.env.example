# ==============================================================================
# Signal-Server MySQL Deployment Environment Variables (.env)
# ==============================================================================
# Copy this file to .env and customize secrets for your VPS:
#   cp .env.example .env
#   chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL / MariaDB Database Connection
# ------------------------------------------------------------------------------
SIGNAL_DB_HOST=127.0.0.1
SIGNAL_DB_PORT=3306
SIGNAL_DB_NAME=signal
SIGNAL_DB_USER=signal
SIGNAL_DB_PASSWORD=replace_with_secure_mysql_password_here

# ------------------------------------------------------------------------------
# 2. Redis Cache & Queues (Single-node cluster or standalone)
# ------------------------------------------------------------------------------
SIGNAL_REDIS_HOST=127.0.0.1
SIGNAL_REDIS_PORT=7000
SIGNAL_REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MinIO S3 Attachment Storage
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minio_signal_admin
MINIO_SECRET_KEY=replace_with_secure_minio_secret_here
ATTACHMENTS_S3_BUCKET=signal-attachments

# ------------------------------------------------------------------------------
# 4. SMS & Production Verification Configuration
# ------------------------------------------------------------------------------
# Secret key required in the X-Admin-Api-Key header for /v1/admin/ APIs
ADMIN_API_KEY=company_admin_secret_key_change_in_production

# Twilio SMS Gateway (Optional: if set, real cellular SMS OTPs are sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Or Generic HTTP SMS Webhook (Optional: JSON {"to":"...","code":"...","message":"..."} will be posted)
SMS_WEBHOOK_URL=

# Restrict user registration to pre-approved allowlist numbers (false = open to all numbers like standard Signal)
REQUIRE_ALLOWLIST=false

# Restrict attachment uploads strictly to active registered company accounts
ATTACHMENT_UPLOAD_ALLOWLIST=true

# ------------------------------------------------------------------------------
# 5. Server Port & Secrets File
# ------------------------------------------------------------------------------
SIGNAL_HTTP_PORT=8080
SIGNAL_ADMIN_PORT=8081
SECRETS_BUNDLE_FILE=/opt/signal-server/config/secrets.bundle.yml
CONFIG_FILE=/opt/signal-server/config/production.yml
